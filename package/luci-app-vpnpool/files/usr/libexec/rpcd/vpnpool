#!/bin/sh
# rpcd backend for luci-app-vpnpool. Exposes ubus object "vpnpool".
# Methods: status (read) + control actions (write).
#
# ---- Reply contract (ROADMAP §6.1) — EVERY method answers one JSON object:
#   {ok: bool, code: "<machine code>", daemon: "signalled"|"not_running"|"n/a", ...data}
#   ok:false replies also carry error = code (older UI code reads .error). daemon says whether
#   the change reached the running daemon: signalled (USR1/USR2 delivered), not_running (it is
#   stored and takes effect at the next start), n/a (the method needs no daemon).
#   No human text here — the UI turns codes into text (po, stage 7).
#
# ---- Codes (the one list; keep it in step with the methods below):
#   success:  ok saved unchanged applied added deleted imported restored started running idle
#             done already_running already_exists cleared set sent on off saved_not_applied
#             empty (export_nodes: nothing to export)
#   failure:  invalid (+ errors:{field: code} — the field codes are listed in api.uc)
#             not_found          the tag / link / URL / domain is not there
#             disabled           the feature is switched off (run_adaptive)
#             not_configured     Telegram token / chat missing
#             daemon_not_running the action needs the running daemon
#             clash_failed       sing-box refused (HTTP code in .http)
#             script_failed      a helper script failed (.message = exit code)
#             fetch_failed       a subscription URL gave no nodes (add_sub)
#             exit_unreachable   conntest: no IP-echo service answered through the tunnel
#             send_failed        Telegram did not accept the message (.http)
#             no_nodes           nothing to work on / nothing parsed
#             low_memory         not enough free RAM for the test
#             nothing_added      add: every item was a duplicate or failed
#             decode_failed      an AmneziaVPN vpn:// link could not be decoded
#             incomplete_config  import/restore: not a full vpnpool config (sections missing)
#             (import/restore also answer invalid + errors when a VALUE fails the set_config schema)
#             too_large          restore: the archive / its content exceeds the limits below
#             restore_failed     restore: a step failed; .rolled_back says whether the state
#                                before is in place again (.backup = the copy taken before)
#             ambiguous          a masked URL fits several configured ones (use the status key)
#             masked_values      import: the text carries masked secrets (use restore)
#             invalid_archive    restore: not a vpnpool backup archive
#             confirm_required   restore without replace_all:true (the reply has the report)
#             write_failed unknown_option unknown_method
#             (set_option / set_schedule / set_url keep the single field's code instead of
#              invalid: bad_value too_small too_large bad_time bad_url ...)
#   warnings (ok:true): warning:"schedule_failed" — settings saved, the crontab rewrite failed
. /usr/libexec/vpnpool/lib.sh 2>/dev/null
CLASH=$(uci -q get vpnpool.main.clash_api); [ -n "$CLASH" ] || CLASH=127.0.0.1:9091
API=/usr/libexec/vpnpool/api.uc
PARSER=/usr/libexec/vpnpool/parser.uc

# rep <true|false> <code> [daemon word] [extra JSON object]
rep() {
	jq -nc --argjson ok "$1" --arg code "$2" --arg d "${3:-n/a}" --argjson x "${4:-null}" \
		'{ok:$ok, code:$code, daemon:$d} + (if $ok then {} else {error:$code} end) + ($x // {})'
}
# An api.uc result on stdin + the daemon word -> the reply (adds daemon, error on failure).
finish() {   # $1=daemon word
	jq -c --arg d "${1:-n/a}" '. + {daemon:$d} + (if .ok then {} else {error:.code} end) | del(.actions)'
}
# Signal the daemon and say how it went, as the "daemon" word of the reply.
signal_word() {   # $1=USR1|USR2|HUP
	if signal_daemon "$1"; then echo signalled; else echo not_running; fi
}
daemon_alive() {
	local p
	p=$(cat /var/run/vpnpool.pid 2>/dev/null); [ -n "$p" ] || return 1
	pgrep -f /usr/libexec/vpnpool/vpnpoold 2>/dev/null | grep -qx "$p"
}
in_list() {   # $1=uci option path $2=value (values without spaces: links, URLs, domains)
	uci -q get "$1" | tr ' ' '\n' | grep -Fxq -- "$2"
}
node_known() {   # $1=tag — present in the live node list?
	jq -e --arg t "$1" 'map(.tag) | index($t) != null' /tmp/vpnpool/nodes.json >/dev/null 2>&1
}

# set_config / set_* : validate + write through api.uc, then do what it asks (one daemon signal,
# bot reload, crontab). $1=--single (legacy single-field codes) or "" ; $2=settings JSON.
# FORCE_SCHED=1 rewrites the crontab even when nothing changed (set_schedule's "Save").
apply_cfg() {
	local res d=n/a a rc sched=${FORCE_SCHED:-0}
	res=$(printf '%s' "$2" | ucode "$API" set_config $1 2>/dev/null)
	[ -n "$res" ] || { rep false script_failed n/a '{"message":"api.uc set_config"}'; return; }
	if [ "$(printf '%s' "$res" | jq -r '.ok')" != true ]; then printf '%s' "$res" | finish n/a; return; fi
	for a in $(printf '%s' "$res" | jq -r '.actions[]?'); do
		case "$a" in
			USR1|USR2) d=$(signal_word "$a") ;;
			# The bot is its own procd instance: `reload` starts/stops it (telegram_control) and
			# restarts it when token/chat/via_proxy changed. The tunnel daemon is not bounced.
			bot) /etc/init.d/vpnpool reload >/dev/null 2>&1 ;;
			sched) sched=1 ;;
		esac
	done
	if [ "$sched" = 1 ]; then
		/usr/libexec/vpnpool/sched.sh >/dev/null 2>&1; rc=$?
		if [ "$rc" -ne 0 ]; then
			# the settings ARE stored (and the daemon signalled): say so, plus the warning
			res=$(printf '%s' "$res" | jq -c --arg m "sched.sh exit $rc" '. + {warning:"schedule_failed", message:$m}')
		else
			res=$(printf '%s' "$res" | jq -c 'if .code == "unchanged" then .code = "applied" else . end')
		fi
	fi
	printf '%s' "$res" | finish "$d"
}
# add (links -> manual_node, URLs -> extra_sub) through api.uc + the one signal it asks for.
apply_add() {   # $1=JSON {text?|items?, lines?, options?}
	local res d=n/a a
	res=$(printf '%s' "$1" | ucode "$API" add 2>/dev/null)
	[ -n "$res" ] || { rep false script_failed n/a '{"message":"api.uc add"}'; return; }
	for a in $(printf '%s' "$res" | jq -r '.actions[]?'); do
		case "$a" in USR1|USR2) d=$(signal_word "$a") ;; esac
	done
	printf '%s' "$res" | finish "$d"
}
# A configured URL by the value the UI shows: full, the status key, or masked scheme://host/***
# when unique. rc 1 = not found, rc 3 = the mask fits several.
resolve_url() {   # $1=uci options (comma-separated) $2=value -> real URL on stdout
	ucode "$API" resolve_url "$1" "$2" 2>/dev/null
}
# need_url <uci options> <value> <must_exist 0|1> -> U = the URL to use, or reply + exit.
# Looked up ONLY in the method's own list(s). A value that is (or looks like) a mask and does not
# resolve is never used as an address: not_found / ambiguous. must_exist=0: a new full URL passes.
need_url() {
	local r rc
	r=$(resolve_url "$1" "$2"); rc=$?
	if [ "$rc" -eq 0 ]; then U=$r; return 0; fi
	[ "$rc" -eq 3 ] && { rep false ambiguous; exit 0; }
	case "$2" in *'***'*) rep false not_found; exit 0 ;; esac
	[ "$3" = 1 ] && { rep false not_found; exit 0; }
	U=$2
}
# Background job results (probe/speedtest/unlock): one shape for running / done / failed / idle.
job_result() {   # $1=running-lock $2=result file
	if [ -f "$1" ]; then
		rep true running n/a '{"running":true}'
	elif [ -f "$2" ]; then
		jq -c '. + {running:false, daemon:"n/a"}
			| if (.ok == false) or ((.error // "") != "")
			  then .ok = false | .code = (.code // .error // "script_failed") | .error = .code
			  else .ok = true | .code = "done" end' "$2" 2>/dev/null \
			|| rep false script_failed n/a '{"running":false}'
	else
		rep true idle n/a '{"running":false}'
	fi
}
# A uci config directory holds a COMPLETE vpnpool config (parses, main + routing present).
check_uci_dir() {   # $1=confdir $2=savedir
	uci -q -c "$1" -t "$2" show vpnpool >/dev/null 2>&1 \
		&& [ "$(uci -q -c "$1" -t "$2" get vpnpool.main)" = vpnpool ] \
		&& [ "$(uci -q -c "$1" -t "$2" get vpnpool.routing)" = routing ]
}
# What a config (+ the awg dir) holds, for backup/restore reports.
cfg_report() {   # $1=confdir $2=savedir $3=awg dir
	local n s e a set
	n=$( { uci -q -c "$1" -t "$2" get vpnpool.main.manual_node; uci -q -c "$1" -t "$2" get vpnpool.main.imported_node; } | tr ' ' '\n' | grep -c '://')
	e=$(uci -q -c "$1" -t "$2" get vpnpool.main.extra_sub | tr ' ' '\n' | grep -c '://')
	[ -n "$(uci -q -c "$1" -t "$2" get vpnpool.main.subscription_url)" ] && e=$((e + 1))
	s=$(uci -q -c "$1" -t "$2" get vpnpool.main.saved_node | tr ' ' '\n' | grep -c '://')
	a=$(ls "$3"/*.conf 2>/dev/null | wc -l)
	set=$(uci -q -c "$1" -t "$2" show vpnpool.main | grep -vc -e '\.manual_node=' -e '\.imported_node=' -e '\.saved_node=' -e '\.extra_sub=' -e '\.subscription_url=' -e '\.active_saved=' -e '\.excluded_node=' -e '=vpnpool$')
	jq -nc --argjson n "${n:-0}" --argjson e "${e:-0}" --argjson s "${s:-0}" --argjson a "${a:-0}" --argjson set "${set:-0}" \
		'{nodes:$n, subscriptions:$e, saved:$s, awg:$a, settings:$set}'
}
# THE rule for what a backup holds — backup() packs only files that match it, restore() accepts
# only members that match it (one rule: our own backup can never be refused). Regular files only.
MEMBER_RE='^(etc/?|etc/config/?|etc/config/vpnpool|etc/vpnpool/?|etc/vpnpool/awg/?|etc/vpnpool/awg/[A-Za-z0-9._-]+\.conf|etc/vpnpool/[A-Za-z0-9._-]+\.map\.json)$'
BACKUP_MAPS='*.map.json'
# Limits of a restore (the unpacked archive lives in /tmp = RAM): checked on the archive's own
# listing BEFORE anything is unpacked, and again on disk after.
RESTORE_MAX_BYTES=4194304      # archive file and the sum of member sizes: 4 MiB
RESTORE_MAX_FILES=500
backup_scan() {   # "ok <rel>" / "skip <rel>" for every candidate file of the live config
	local f rel
	echo "ok etc/config/vpnpool"
	for f in /etc/vpnpool/awg/* /etc/vpnpool/$BACKUP_MAPS; do
		[ -e "$f" ] || [ -L "$f" ] || continue
		rel=${f#/}
		if [ -f "$f" ] && [ ! -L "$f" ] && printf '%s\n' "$rel" | grep -Eq "$MEMBER_RE"; then
			echo "ok $rel"
		else
			echo "skip $rel"
		fi
	done
}
backup_members() { backup_scan | sed -n 's/^ok //p'; }   # names never contain spaces (MEMBER_RE)

# Drop a tag from the dashboard's node list (nodes.json) RIGHT NOW. signal_reload only
# rebuilds asynchronously (USR1), and a full rebuild of a big pool takes several seconds —
# long enough that the 3 s dashboard poll catches the not-yet-rebuilt list and the node looks
# like it "didn't delete" (then reappears gone a poll later -> "deletes every other time").
# Pruning here makes the very next poll reflect the delete; the async rebuild then regenerates
# the authoritative config. status.sh reads /tmp/vpnpool/nodes.json directly.
prune_nodes_json() {   # $1=tag
	local NJ=/tmp/vpnpool/nodes.json
	[ -n "$1" ] && [ -f "$NJ" ] || return 0
	jq --arg t "$1" 'map(select(.tag != $t))' "$NJ" > "$NJ.pt" 2>/dev/null && mv "$NJ.pt" "$NJ"
}

# Remove ONE node by tag: resolve its link, drop it from whichever list owns it, prune the
# saved/snapshot maps, and (for a pure subscription node) add its link to excluded_node so a
# refetch can't bring it back. STAGES uci changes only — the caller must rebuild_saved_list
# (which commits) and signal_reload. Lets delete_node (one) and delete_nodes (bulk) share the
# logic so a bulk delete does ONE rebuild+reload instead of N sing-box restarts. Returns 1 if
# the tag has no resolvable link.
_delete_one_tag() {   # $1=tag
	local tag="$1" link="" removed=0 LINKS=/etc/vpnpool/links.json MAP __af
	[ -n "$tag" ] || return 1
	# AmneziaWG nodes are stored as /etc/vpnpool/awg/*.conf files (no vless-style link).
	# If the tag matches a stored .conf, remove that file and clear its keep-auto state.
	for __af in /etc/vpnpool/awg/*.conf; do
		[ -f "$__af" ] || continue
		if [ "$(ucode "$PARSER" "$__af" 2>/dev/null | jq -r '.[0].tag // ""')" = "$tag" ]; then
			rm -f "$__af"
			uci del_list vpnpool.main.keep_auto="$tag" 2>/dev/null
			return 0
		fi
	done
	[ -f "$LINKS" ] && link=$(jq -r --arg t "$tag" 'map(select(.tag==$t)) | .[0].link // ""' "$LINKS" 2>/dev/null)
	[ -n "$link" ] || link=$(saved_link_for_tag "$tag")
	[ -n "$link" ] || return 1
	if in_list vpnpool.main.manual_node "$link"; then
		uci del_list vpnpool.main.manual_node="$link"; removed=1
	fi
	if in_list vpnpool.main.imported_node "$link"; then
		uci del_list vpnpool.main.imported_node="$link"; removed=1
		MAP=/etc/vpnpool/imported.map.json
		[ -f "$MAP" ] && { jq --arg l "$link" 'map_values(map(select(. != $l)))' "$MAP" > "$MAP.t" 2>/dev/null && mv "$MAP.t" "$MAP"; }
	fi
	if in_list vpnpool.main.active_saved "$link"; then
		uci del_list vpnpool.main.active_saved="$link"; removed=1
	fi
	# Deleting a node must NOT touch the ⭐ saved archive (saved.map / snapshot.map). The
	# archive is a deliberate "keep forever" store with its own unsave (💾); pruning it here
	# meant a bulk delete could wipe the WHOLE inactive-saved pool. Delete now only removes
	# from the active pool (+ excludes subscription nodes); the archive stays re-activatable.
	if [ "$removed" = 0 ]; then
		in_list vpnpool.main.excluded_node "$link" || uci add_list vpnpool.main.excluded_node="$link"
	fi
	# Drop any "out of auto-pool" state for this tag so a deleted node leaves that list at
	# once: the force-keep override (keep_auto), the dead set, and its strike counter.
	uci del_list vpnpool.main.keep_auto="$tag" 2>/dev/null
	[ -f /tmp/vpnpool/.dead_tags.json ] && { jq --arg t "$tag" 'map(select(. != $t))' /tmp/vpnpool/.dead_tags.json > /tmp/vpnpool/.dt.t 2>/dev/null && mv /tmp/vpnpool/.dt.t /tmp/vpnpool/.dead_tags.json; }
	[ -f /tmp/vpnpool/.deadstrikes ] && { local TAB; TAB=$(printf '\t'); awk -F"$TAB" -v k="$tag" '$1!=k' /tmp/vpnpool/.deadstrikes > /tmp/vpnpool/.ds.t 2>/dev/null && mv /tmp/vpnpool/.ds.t /tmp/vpnpool/.deadstrikes; }
	return 0
}

case "$1" in
list)
	cat <<'L'
{ "status": {}, "diag": {}, "conntest": {}, "leases": {}, "export": {}, "import": { "config": "x" }, "set_enabled": { "enabled": true }, "select": { "tag": "x" }, "refresh": {}, "ping": {}, "set_url": { "url": "x" }, "del_subscription": {}, "del_source": { "url": "x" }, "add_node": { "link": "x" }, "del_node": { "link": "x" }, "import_nodes": { "text": "x" }, "delete_node": { "tag": "x" }, "delete_nodes": { "tags": [] }, "restore_node": { "tag": "x" }, "refilter_node": { "tag": "x" }, "save_node": { "tag": "x" }, "unsave_node": { "tag": "x" }, "activate_saved": { "tag": "x" }, "deactivate_saved": { "tag": "x" }, "node_link": { "tag": "x" }, "export_nodes": { "scope": "x" }, "add_sub": { "url": "x" }, "del_sub": { "url": "x" }, "unlock": { "tag": "x" }, "unlock_result": {}, "add_auto_domain": { "domain": "x" }, "del_auto_domain": { "domain": "x" }, "run_adaptive": {}, "set_domains": { "domains": [] }, "set_communities": { "communities": [] }, "set_option": { "name": "x", "value": "y" }, "set_clients": { "mode": "all", "clients": [], "devices": [] }, "set_auto_members": { "members": [] }, "set_preferred": { "tag": "x" }, "set_schedule": { "enabled": true, "on": "x", "off": "x", "refresh": "x" }, "speedtest": { "tag": "x" }, "speedtest_result": {}, "probe_source": { "url": "x" }, "probe_result": {}, "import_select": { "url": "x", "idx": [] }, "tg_test": {}, "set_config": { "settings": {} }, "analyze": { "text": "x" }, "add": { "text": "x", "items": [], "lines": [], "options": {} }, "backup": {}, "restore": { "data": "x", "path": "x", "replace_all": false } }
L
	;;
call)
	input="$(cat)"
	case "$2" in
	status)
		/usr/libexec/vpnpool/status.sh
		;;
	diag)
		/usr/libexec/vpnpool/diag.sh 2>/dev/null | jq -c '. + {ok:true, code:"ok", daemon:"n/a"}' 2>/dev/null \
			|| rep false script_failed n/a '{"message":"diag.sh"}'
		;;
	export)
		# uci export with the Telegram token and subscription URLs MASKED (§6.5). The full
		# copy with secrets is backup() (write ACL). An export can't be imported back as-is
		# (import refuses masked values) — restore(backup) is the complete round trip.
		mkdir -p /tmp/vpnpool
		if ucode "$API" export > /tmp/vpnpool/.export.txt 2>/dev/null; then
			jq -nc --rawfile c /tmp/vpnpool/.export.txt '{ok:true, code:"ok", daemon:"n/a", masked:true, config:$c}'
		else
			rep false script_failed n/a '{"message":"uci export"}'
		fi
		rm -f /tmp/vpnpool/.export.txt
		;;
	import)
		# Legacy text import of a uci config. Checked in a scratch uci dir FIRST: it must parse
		# and be COMPLETE (main + routing) — a partial text would otherwise replace (wipe) the
		# rest of the config, so it is refused (incomplete_config), not merged. A masked export
		# is refused too (masked_values): importing it would store "***" as the token / URLs.
		D=/tmp/vpnpool/.import; rm -rf "$D"; mkdir -p "$D/save"
		printf '%s' "$input" | jq -r '.config // ""' > "$D/vpnpool" 2>/dev/null
		if [ ! -s "$D/vpnpool" ]; then rm -rf "$D"; rep false invalid n/a '{"errors":{"config":"bad_value"}}'; exit 0; fi
		if ! check_uci_dir "$D" "$D/save"; then rm -rf "$D"; rep false incomplete_config; exit 0; fi
		if ucode "$API" has_masked "$D/vpnpool"; then rm -rf "$D"; rep false masked_values; exit 0; fi
		CC=$(ucode "$API" check_config "$D" "$D/save" 2>/dev/null)
		if [ "$(printf '%s' "$CC" | jq -r '.ok' 2>/dev/null)" != true ]; then
			[ -n "$CC" ] || CC='{"ok":false,"code":"invalid"}'
			rm -rf "$D"; printf '%s' "$CC" | finish n/a; exit 0
		fi
		uci -q revert vpnpool
		if ! uci import vpnpool < "$D/vpnpool" || ! uci commit vpnpool; then rm -rf "$D"; rep false write_failed; exit 0; fi
		rm -rf "$D"
		rep true imported "$(signal_word USR2)"
		;;
	conntest)
		# Exit-IP test through the tunnel. Try SEVERAL IP-echo endpoints, not just one — a
		# single service (ifconfig.co) frequently blocks/ratelimits datacenter exit IPs, which
		# made a perfectly working tunnel report "exit test failed / service not running".
		# Succeeds on the first endpoint that returns an IP. Different JSON shapes are parsed
		# generically (ip/ip_addr/query, country/country_iso/country_code).
		TP=$(uci -q get vpnpool.main.test_port); [ -n "$TP" ] || TP=1605
		IP=""; CO=""
		for url in "https://ifconfig.co/json" "https://ipinfo.io/json" "https://api.ip.sb/geoip" "https://api.ipify.org?format=json"; do
			J=$(curl -s -m 7 --proxy "socks5h://127.0.0.1:$TP" "$url" 2>/dev/null)
			[ -n "$J" ] || continue
			IP=$(echo "$J" | jq -r '(.ip // .ip_addr // .query // "") | tostring' 2>/dev/null)
			[ -n "$IP" ] && [ "$IP" != "null" ] || { IP=""; continue; }
			CO=$(echo "$J" | jq -r '(.country_iso // .country_code // .country // "") | tostring' 2>/dev/null); [ "$CO" = "null" ] && CO=""
			break
		done
		X=$(jq -nc --arg ip "$IP" --arg co "$CO" '{ip:$ip, country:$co}')
		if [ -n "$IP" ]; then rep true ok n/a "$X"
		elif daemon_alive; then rep false exit_unreachable n/a "$X"
		else rep false daemon_not_running not_running "$X"; fi
		;;
	leases)
		# Current DHCP leases for the device picker in per-client routing.
		# /tmp/dhcp.leases columns: <expiry> <mac> <ip> <hostname> <clientid>.
		# Read-only. MUST emit a JSON OBJECT — rpcd's exec plugin rejects a top-level
		# array with INVALID_ARGUMENT — so wrap the list as { leases: [{mac,ip,host}] }.
		# hostname "*" -> "" so the UI falls back to showing the IP.
		awk '{print $2" "$3" "$4}' /tmp/dhcp.leases 2>/dev/null \
			| jq -R -s -c '{ ok:true, code:"ok", daemon:"n/a", leases: (split("\n")|map(select(length>0)|split(" ")
				|{mac:(.[0]//""), ip:(.[1]//""), host:((.[2]//"") | if .=="*" then "" else . end)})
				|map(select(.mac!="" and .ip!=""))) }' 2>/dev/null || rep true ok n/a '{"leases":[]}'
		;;
	set_enabled)
		en=$(printf '%s' "$input" | jq -r '.enabled | if . == true or . == 1 or . == "1" or . == "true" then "on"
			elif . == false or . == 0 or . == "0" or . == "false" then "off" else "bad" end' 2>/dev/null)
		# power.sh: ONE on/off for LuCI, the schedule and Telegram. "off" stops only the daemon
		# (routes removed) and keeps the Telegram bot; "on" ends a Telegram pause and starts
		# the daemon if needed — a running one is not restarted (no routing gap).
		case "$en" in
			on|off)
				/usr/libexec/vpnpool/power.sh "$en" >/dev/null 2>&1; rc=$?
				if [ "$rc" -eq 0 ]; then rep true "$en"
				else rep false script_failed n/a "$(jq -nc --arg m "power.sh exit $rc" '{message:$m}')"; fi ;;
			*) rep false invalid n/a '{"errors":{"enabled":"bad_value"}}' ;;
		esac
		;;
	select)
		tag=$(printf '%s' "$input" | jq -r '.tag // ""')
		[ -n "$tag" ] || { rep false invalid n/a '{"errors":{"tag":"bad_tag"}}'; exit 0; }
		# Switch the live selector first and check sing-box's answer (204 = switched). A tag
		# sing-box doesn't know is refused, not stored. If sing-box is not running (no
		# answer) the pick is stored for the next start when the node exists in the list.
		code=$(curl -s -m5 -o /dev/null -w '%{http_code}' -X PUT "http://$CLASH/proxies/proxy" \
			--data "$(jq -nc --arg n "$tag" '{name:$n}')" 2>/dev/null)
		d=n/a
		case "$code" in
			204) res=applied ;;
			''|000)
				if [ "$tag" != auto ] && ! node_known "$tag"; then rep false not_found; exit 0; fi
				res=saved_not_applied; d=not_running ;;
			*) rep false clash_failed n/a "$(jq -nc --arg h "$code" '{http:$h}')"; exit 0 ;;
		esac
		# persist the pick so it survives reload / subscription updates ('auto' clears it)
		if [ "$tag" = "auto" ]; then
			uci set vpnpool.main.selected_node=''
		else
			uci set vpnpool.main.selected_node="$tag"
		fi
		uci commit vpnpool
		rep true "$res" "$d"
		;;
	refresh)
		# Re-fetch every subscription + rebuild + hot-reload: USR2 to the running daemon
		# (it keeps routing per the fail-safe while it reloads). Never a full service
		# restart — that tore routing down and bounced the Telegram bot for nothing.
		d=$(signal_word USR2)
		if [ "$d" = signalled ]; then rep true started "$d"; else rep false daemon_not_running "$d"; fi
		;;
	ping)
		# Ping every node (clash delay against the PRIMARY check service, so the shown delay
		# means "this node reaches the wanted service") in BATCHES of prefilter_concurrency,
		# in the background — the UI follows status.ping_progress (/tmp/vpnpool/.ping-progress.json
		# {running,done,total,alive}). ping.sh then starts the dead-node filter sweep.
		mkdir -p /tmp/vpnpool
		daemon_alive || { rep false daemon_not_running not_running; exit 0; }
		clear_stale_lock /tmp/vpnpool/.ping-running 600
		if [ -f /tmp/vpnpool/.ping-running ]; then rep true already_running; exit 0; fi
		[ -s /tmp/vpnpool/nodes.json ] || { rep false no_nodes; exit 0; }
		: > /tmp/vpnpool/.ping-running
		setsid sh -c '/usr/libexec/vpnpool/ping.sh; rm -f /tmp/vpnpool/.ping-running' >/dev/null 2>&1 &
		echo $! > /tmp/vpnpool/.ping-running   # worker PID -> clear_stale_lock frees it if it dies
		rep true started
		;;
	set_url)
		# The primary subscription URL. The status reply shows it masked; that masked value
		# sent back means "unchanged" (api.uc). Through the common validator (http/https).
		apply_cfg --single "$(printf '%s' "$input" | jq -c '{subscription_url: (.url // "")}')"
		;;
	del_subscription)
		# Promote EVERY saved (archived) node into the live pool BEFORE dropping the
		# subscription — otherwise deleting the sub would empty the pool and kill the
		# tunnel. saved_archive_json = manual ⭐ UNION auto-snapshot; add each link to
		# active_saved (deduped). The subsequent refetch rebuilds with no primary sub but
		# WITH these promoted nodes, so connectivity survives the deletion.
		[ -n "$(uci -q get vpnpool.main.subscription_url)" ] || { rep false not_found; exit 0; }
		saved_archive_json 2>/dev/null | jq -r '.[].link // empty' 2>/dev/null | while IFS= read -r l; do
			[ -n "$l" ] || continue
			in_list vpnpool.main.active_saved "$l" && continue
			uci add_list vpnpool.main.active_saved="$l"
		done
		uci -q delete vpnpool.main.subscription_url
		# Clear the manual node-exclude list too — it only held links from THIS
		# subscription's nodes (hidden via the dashboard ✕); with the subscription gone
		# they're meaningless, so a future subscription starts with a clean slate.
		uci -q delete vpnpool.main.excluded_node
		uci commit vpnpool
		rm -f /etc/vpnpool/sub.expire /etc/vpnpool/sub.usage
		# Drop the cached subscription nodes so they LEAVE the dashboard. Without this,
		# fetch.sh's offline-cache fallback (no URL -> 0 fetched -> restore cache) would
		# repopulate the OLD subscription nodes. Saved nodes survive (promoted to
		# active_saved above); manual/imported are their own lists; extra_sub re-fetch.
		rm -rf /etc/vpnpool/sources_cache /tmp/vpnpool/sources
		d=$(signal_word USR2)
		promoted=$(uci -q get vpnpool.main.active_saved 2>/dev/null | tr ' ' '\n' | grep -c '://')
		rep true deleted "$d" "{\"promoted\":${promoted:-0}}"
		;;
	probe_source)
		# Fetch + parse + ICMP-ping one URL. On a slow (mips) router this can exceed
		# rpcd's exec timeout, so run it in the BACKGROUND and let the UI poll
		# probe_result. Read-only w.r.t. the live config. A listed (masked) source URL is
		# resolved to the configured one.
		need_url source "$(printf '%s' "$input" | jq -r '.url // ""')" 0; u=$U
		case "$u" in
			http://*|https://*) case "$u" in *[[:space:]]*) rep false invalid n/a '{"errors":{"url":"bad_url"}}'; exit 0 ;; esac ;;
			*) rep false invalid n/a '{"errors":{"url":"bad_url"}}'; exit 0 ;;
		esac
		mkdir -p /tmp/vpnpool
		clear_stale_lock /tmp/vpnpool/.probe-running 180   # don't let a killed probe block forever
		if [ -f /tmp/vpnpool/.probe-running ]; then rep true already_running n/a '{"running":true,"already":true}'; exit 0; fi
		: > /tmp/vpnpool/.probe-running
		rm -f /tmp/vpnpool/.probe-result.json
		setsid sh -c '/usr/libexec/vpnpool/probe.sh "$1" > /tmp/vpnpool/.probe-result.json 2>/dev/null; rm -f /tmp/vpnpool/.probe-running' _ "$u" >/dev/null 2>&1 &
		echo $! > /tmp/vpnpool/.probe-running   # record worker PID -> clear_stale_lock frees it the instant it dies
		rep true started n/a '{"running":true,"started":true}'
		;;
	probe_result)
		job_result /tmp/vpnpool/.probe-running /tmp/vpnpool/.probe-result.json
		;;
	import_select)
		# The UI sends only { url, idx:[picked indices] }. We resolve those indices to
		# links from the server-side probe cache (probe.sh wrote it), so the browser
		# never uploads hundreds of links (that large request never reached rpcd).
		# imported_node := (current - scopeOfThisSource) + picked, so re-probing
		# ("Update") and re-selecting cleanly replaces just this source's contribution.
		need_url source "$(printf '%s' "$input" | jq -r '.url // ""')" 0; u=$U
		IX=$(printf '%s' "$input" | jq -c '.idx // []')
		printf '%s' "$IX" | jq -e 'type=="array"' >/dev/null 2>&1 || { rep false invalid n/a '{"errors":{"idx":"bad_type"}}'; exit 0; }
		CACHE=/tmp/vpnpool/.probe-cache.json
		MAP=/etc/vpnpool/imported.map.json
		# the picks must come from a probe of THIS url
		if [ -z "$u" ] || [ ! -f "$CACHE" ] || [ "$(jq -r '.url // ""' "$CACHE" 2>/dev/null)" != "$u" ]; then
			rep false not_found; exit 0
		fi
		mkdir -p /etc/vpnpool; [ -f "$MAP" ] || echo '{}' > "$MAP"
		SEL=$(jq -c --argjson ix "$IX" \
			'[ .nodes[] | select(.i as $i | $ix | index($i)) | .link ] | map(select(. != null and . != ""))' "$CACHE")
		# store this source's picks (replaces its previous set), then regenerate the
		# flat imported_node list as the unique union of every source's links.
		jq --arg u "$u" --argjson sel "$SEL" '.[$u] = $sel' "$MAP" > "$MAP.tmp" 2>/dev/null && mv "$MAP.tmp" "$MAP"
		uci -q delete vpnpool.main.imported_node
		jq -r '[.[][]] | unique | .[]' "$MAP" 2>/dev/null | while IFS= read -r l; do
			[ -n "$l" ] && uci add_list vpnpool.main.imported_node="$l"
		done
		in_list vpnpool.main.source "$u" || uci add_list vpnpool.main.source="$u"
		uci commit vpnpool
		rep true imported "$(signal_word USR1)" "{\"count\":$(printf '%s' "$SEL" | jq 'length')}"
		;;
	del_source)
		# forget the source URL AND drop the nodes imported from it (they must leave
		# the pool / dashboard, not linger).
		need_url source "$(printf '%s' "$input" | jq -r '.url // ""')" 1; u=$U
		MAP=/etc/vpnpool/imported.map.json
		uci del_list vpnpool.main.source="$u" 2>/dev/null
		[ -f "$MAP" ] && { jq --arg u "$u" 'del(.[$u])' "$MAP" > "$MAP.tmp" 2>/dev/null && mv "$MAP.tmp" "$MAP"; }
		uci -q delete vpnpool.main.imported_node
		[ -f "$MAP" ] && jq -r '[.[][]] | unique | .[]' "$MAP" 2>/dev/null | while IFS= read -r l; do
			[ -n "$l" ] && uci add_list vpnpool.main.imported_node="$l"
		done
		uci commit vpnpool
		rep true deleted "$(signal_word USR1)"
		;;
	set_config)
		# ONE save for a settings page (§6.3): every value checked, nothing written on any
		# error, one uci commit, one needed signal. Accepts {settings:{...}} or the flat object.
		apply_cfg "" "$(printf '%s' "$input" | jq -c 'if (.settings | type) == "object" then .settings else . end' 2>/dev/null)"
		;;
	set_communities)
		apply_cfg "" "$(printf '%s' "$input" | jq -c '{communities: .communities}')"
		;;
	set_auto_members)
		# Which node tags take part in urltest auto-switching. Empty list = ALL
		# nodes (default; future nodes auto-join). A non-empty list pins the pool.
		apply_cfg "" "$(printf '%s' "$input" | jq -c '{auto_members: .members}')"
		;;
	set_domains)
		apply_cfg "" "$(printf '%s' "$input" | jq -c '{domains: .domains}')"
		;;
	set_clients)
		# Per-client routing. clients[] = raw IPv4 (typed manually); devices[] = MAC
		# addresses (picked by DHCP name). MACs are stable across DHCP renewals, so a
		# device stays matched even when its IP changes — route.sh builds an @clients
		# (ip) set and an @clients_mac (ether) set, a host matches if EITHER hits.
		apply_cfg "" "$(printf '%s' "$input" | jq -c '{client_mode: (.mode // "all"), clients: (.clients // []), client_devices: (.devices // [])}')"
		;;
	set_option)
		# One setting (legacy; the settings pages move to set_config). Validated by the same
		# schema; the reply code is the field's own code (bad_value, too_small, ...).
		apply_cfg --single "$(printf '%s' "$input" | jq -c '{(.name // "" | tostring): .value}' 2>/dev/null)"
		;;
	set_preferred)
		# Preferred-node soft pin, set straight from the dashboard (📌). Toggle: pinning
		# the already-preferred node (or an empty tag) clears it back to auto. Setting a
		# new preferred node also releases any HARD manual pin (selected_node) so the soft
		# pin can actually take over. No signal_reload: preferred_node is read live by the
		# daemon's preferred_check, which switches the running selector via the clash API
		# within one supervise tick — so the tunnel is never bounced just to pin a node.
		t=$(printf '%s' "$input" | jq -r '.tag // ""')
		cur=$(uci -q get vpnpool.main.preferred_node)
		if [ -z "$t" ] || [ "$t" = "$cur" ]; then
			uci -q delete vpnpool.main.preferred_node; uci commit vpnpool
			rep true cleared
		elif node_known "$t"; then
			uci set vpnpool.main.preferred_node="$t"
			uci -q delete vpnpool.main.selected_node
			uci commit vpnpool
			rep true set
		else
			rep false not_found
		fi
		;;
	tg_test)
		if [ -z "$(uci -q get vpnpool.main.telegram_token)" ] || [ -z "$(uci -q get vpnpool.main.telegram_chat)" ]; then
			rep false not_configured; exit 0
		fi
		code=$(tg_send "✅ vpnpool: test message" 2>/dev/null)
		if [ "$code" = "200" ]; then rep true sent
		else rep false send_failed n/a "$(jq -nc --arg h "${code:-000}" '{http:$h}')"; fi
		;;
	add_node)
		# One link (legacy; the "Add" dialog moves to analyze + add). Checked by the parser:
		# junk is refused, an existing node is not added twice (a double-click).
		l=$(printf '%s' "$input" | jq -r '.link // ""')
		[ -n "$l" ] || { rep false invalid n/a '{"errors":{"link":"bad_value"}}'; exit 0; }
		case "$(printf '%s' "$l" | tr 'A-Z' 'a-z')" in
			http://*|https://*) rep false invalid n/a '{"errors":{"link":"bad_value"}}'; exit 0 ;;
		esac
		res=$(apply_add "$(jq -nc --arg l "$l" '{items:[$l]}')")
		if printf '%s' "$res" | jq -e '.ok == false and .code == "nothing_added" and .dup > 0' >/dev/null 2>&1; then
			rep true already_exists
		elif printf '%s' "$res" | jq -e '.ok == false and .code == "nothing_added"' >/dev/null 2>&1; then
			printf '%s' "$res" | jq -c '.ok = false | .code = "invalid" | .error = "invalid"'
		else
			printf '%s' "$res"
		fi
		;;
	del_node)
		l=$(printf '%s' "$input" | jq -r '.link // ""')
		{ [ -n "$l" ] && in_list vpnpool.main.manual_node "$l"; } || { rep false not_found; exit 0; }
		uci del_list vpnpool.main.manual_node="$l"; uci commit vpnpool
		rep true deleted "$(signal_word USR1)"
		;;
	analyze)
		# Dry run of a paste for the "Add" dialog: per line kind / status / reason, nothing
		# written. (AmneziaWG vpn:// and .conf: kind awg, status pending_stage4 until stage 4.)
		printf '%s' "$input" | ucode "$API" analyze 2>/dev/null | finish n/a \
			|| rep false script_failed n/a '{"message":"api.uc analyze"}'
		;;
	add)
		# Write what analyze accepts: links -> manual_node, http(s) URLs -> extra_sub.
		# {text, lines?:[line numbers to take]} or {items:[link|url, ...]}.
		apply_add "$input"
		;;
	import_nodes)
		# Bulk-import nodes by pasted text OR an uploaded file (the browser reads the
		# file and sends its text here). Accepts a list of node links (one per line) OR
		# a whole base64 subscription blob. We DON'T decode/parse in the shell — we hand
		# the raw text to parser.uc (the SAME parser the build uses): it auto-detects a
		# base64 subscription vs a plain link list, normalises each node, and with
		# --keep-link returns the original vless:// (vmess/trojan/ss/…) link. This avoids
		# any dependency on a `base64` applet (absent on tiny busybox builds) and the
		# whitespace-split bug (links are one-per-line; tags may contain spaces). Every
		# resulting link is added to the persistent manual_node list, deduped.
		txt=$(printf '%s' "$input" | jq -r '.text // ""')
		[ -n "$txt" ] || { rep false invalid n/a '{"errors":{"text":"bad_value"}}'; exit 0; }
		mkdir -p /tmp/vpnpool
		RAW=/tmp/vpnpool/.import.raw
		printf '%s\n' "$txt" > "$RAW"
		# AmneziaVPN vpn:// link -> decode to a .conf ON THE ROUTER (no browser/zlib dep):
		# awgdecode.uc base64url-decodes + inflates the zlib payload in pure ucode and prints
		# the embedded AmneziaWG .conf. Then it flows through the .conf path below.
		case "$txt" in
			vpn://*)
				dec=$(printf '%s' "$txt" | ucode /usr/libexec/vpnpool/awgdecode.uc 2>/dev/null)
				if [ -n "$dec" ]; then printf '%s\n' "$dec" > "$RAW"; txt="$dec"
				else rm -f "$RAW"; rep false decode_failed; exit 0; fi
				;;
		esac
		# AmneziaWG / WireGuard .conf: multi-line INI, no single-line link — store the whole
		# config as its own file under /etc/vpnpool/awg/ (build.sh globs them). A vpn:// link
		# was already decoded to such a .conf above (awgdecode.uc, on the router).
		# Validate it parses to an 'awg' endpoint before saving so junk isn't kept.
		if printf '%s' "$txt" | grep -qF '[Interface]'; then
			if ucode "$PARSER" "$RAW" 2>/dev/null | jq -e '.[0].type=="awg"' >/dev/null 2>&1; then
				mkdir -p /etc/vpnpool/awg
				id=$(md5sum "$RAW" | cut -c1-12)
				cp "$RAW" "/etc/vpnpool/awg/$id.conf"
				rm -f "$RAW"
				rep true added "$(signal_word USR1)" "$(jq -nc --arg id "$id" '{awg:true, added:1, id:$id}')"
			else
				rm -f "$RAW"; rep false invalid n/a '{"reason":"bad_awg_config"}'
			fi
			exit 0
		fi
		TMP=/tmp/vpnpool/.import.links
		ucode "$PARSER" --keep-link "$RAW" 2>/dev/null \
			| jq -r '.[]?._link // empty' 2>/dev/null \
			| awk 'NF && !seen[$0]++' > "$TMP"
		rm -f "$RAW"
		if [ ! -s "$TMP" ]; then rm -f "$TMP"; rep false no_nodes; exit 0; fi
		added=0
		while IFS= read -r l; do
			[ -n "$l" ] || continue
			if in_list vpnpool.main.manual_node "$l"; then :; else
				uci add_list vpnpool.main.manual_node="$l" && added=$((added + 1))
			fi
		done < "$TMP"
		rm -f "$TMP"
		d=n/a
		if [ "$added" -gt 0 ]; then uci commit vpnpool; d=$(signal_word USR1); fi
		total=$(uci -q get vpnpool.main.manual_node 2>/dev/null | tr ' ' '\n' | grep -c '://')
		X=$(jq -nc --argjson a "$added" --argjson t "${total:-0}" '{added:$a, total:$t}')
		if [ "$added" -gt 0 ]; then rep true added "$d" "$X"; else rep true already_exists n/a "$X"; fi
		;;
	delete_node)
		# Manual node removal from the dashboard ✕. Resolve the node's link by tag, then
		# remove it from whichever list owns it. A pure SUBSCRIPTION node has no own list,
		# so we add its link to excluded_node — build.sh filters those out every build, so
		# a refetch can't bring it back. (excluded_node is wiped on del_subscription.)
		tag=$(printf '%s' "$input" | jq -r '.tag // ""')
		[ -n "$tag" ] || { rep false invalid n/a '{"errors":{"tag":"bad_tag"}}'; exit 0; }
		if _delete_one_tag "$tag"; then
			prune_nodes_json "$tag"  # reflect the delete on the next poll (pre-rebuild)
			rebuild_saved_list      # commits vpnpool (incl. the staged del_lists)
			rep true deleted "$(signal_word USR1)"
		else
			rep false not_found
		fi
		;;
	delete_nodes)
		# Bulk delete: stage every removal, then do ONE rebuild + ONE reload at the end.
		# Deleting N nodes one-by-one fired N signal_reloads = N sing-box restarts in a row
		# (tunnel flapping). Tags can contain spaces, so read one-per-line (never split).
		# A file, not a pipe: the loop must run in THIS shell to count.
		TL=/tmp/vpnpool/.del-tags; mkdir -p /tmp/vpnpool
		printf '%s' "$input" | jq -r '.tags[]? // empty' > "$TL" 2>/dev/null
		n=0; : > "$TL.miss"
		while IFS= read -r t; do
			[ -n "$t" ] || continue
			if _delete_one_tag "$t"; then prune_nodes_json "$t"; n=$((n + 1)); else printf '%s\n' "$t" >> "$TL.miss"; fi
		done < "$TL"
		MISS=$(jq -R . "$TL.miss" | jq -sc .); rm -f "$TL" "$TL.miss"
		if [ "$n" -eq 0 ]; then rep false not_found n/a "{\"deleted\":0,\"missing\":$MISS}"; exit 0; fi
		rebuild_saved_list      # commits all staged del_lists/excludes from the loop
		rep true deleted "$(signal_word USR1)" "{\"deleted\":$n,\"missing\":$MISS}"
		;;
	restore_node)
		# Manual override of the service-accuracy dead-filter: force this node BACK into the
		# auto pool and keep it there even if the service check keeps failing. Adds its tag
		# to the keep_auto whitelist (which nodecheck.sh skips, so it never re-enters
		# .dead_tags.json), prunes it from the current dead set + strike counter, and
		# rebuilds so it rejoins auto immediately. The TCP prefilter still applies, so a
		# truly TCP-dead node won't be forced into the pool (no hung-socket regression).
		tag=$(printf '%s' "$input" | jq -r '.tag // ""')
		[ -n "$tag" ] || { rep false invalid n/a '{"errors":{"tag":"bad_tag"}}'; exit 0; }
		node_known "$tag" || { rep false not_found; exit 0; }
		exists=0
		. /lib/functions.sh 2>/dev/null
		__ck() { [ "$1" = "$tag" ] && exists=1; }
		config_load vpnpool 2>/dev/null
		config_list_foreach main keep_auto __ck 2>/dev/null
		[ "$exists" = 1 ] || { uci add_list vpnpool.main.keep_auto="$tag"; uci commit vpnpool; }
		DEAD=/tmp/vpnpool/.dead_tags.json
		[ -f "$DEAD" ] && { jq --arg t "$tag" 'map(select(. != $t))' "$DEAD" > "$DEAD.t" 2>/dev/null && mv "$DEAD.t" "$DEAD"; }
		STRK=/tmp/vpnpool/.deadstrikes
		[ -f "$STRK" ] && { TAB=$(printf '\t'); awk -F"$TAB" -v k="$tag" '$1!=k' "$STRK" > "$STRK.t" 2>/dev/null && mv "$STRK.t" "$STRK"; }
		rep true saved "$(signal_word USR1)"
		;;
	refilter_node)
		# Undo restore_node: drop the tag from keep_auto so the service-accuracy filter can
		# demote it again. Rebuild so the pool reflects the current dead set.
		tag=$(printf '%s' "$input" | jq -r '.tag // ""')
		[ -n "$tag" ] || { rep false invalid n/a '{"errors":{"tag":"bad_tag"}}'; exit 0; }
		exists=0
		. /lib/functions.sh 2>/dev/null
		__ck() { [ "$1" = "$tag" ] && exists=1; }
		config_load vpnpool 2>/dev/null
		config_list_foreach main keep_auto __ck 2>/dev/null
		[ "$exists" = 1 ] || { rep false not_found; exit 0; }
		uci del_list vpnpool.main.keep_auto="$tag" 2>/dev/null
		uci commit vpnpool
		rep true saved "$(signal_word USR1)"
		;;
	save_node)
		# persist a subscription node into the separate "saved" store so it stays
		# available after the subscription expires. Resolve tag -> original link
		# from the build-time map, keep a tag->link map, regenerate the uci list.
		tag=$(printf '%s' "$input" | jq -r '.tag // ""')
		MAP=/etc/vpnpool/saved.map.json
		LINKS=/etc/vpnpool/links.json
		mkdir -p /etc/vpnpool; [ -f "$MAP" ] || echo '{}' > "$MAP"
		link=""
		[ -f "$LINKS" ] && link=$(jq -r --arg t "$tag" 'map(select(.tag==$t)) | .[0].link // ""' "$LINKS" 2>/dev/null)
		if [ -n "$tag" ] && [ -n "$link" ]; then
			jq --arg t "$tag" --arg l "$link" '.[$t]=$l' "$MAP" > "$MAP.tmp" 2>/dev/null && mv "$MAP.tmp" "$MAP"
			# Saving only updates the INACTIVE archive — it does NOT change the live
			# sing-box config, so NO signal_reload here (that full rebuild is what made
			# the ⭐ feel laggy/flaky and needlessly bounced the tunnel). rebuild_saved_list
			# refreshes the uci saved_node archive list for export; the dashboard star
			# reflects the map write immediately on the next status poll.
			rebuild_saved_list
			rep true saved
		else
			rep false not_found
		fi
		;;
	unsave_node)
		# remove from BOTH the manual map and the auto-snapshot map, so an unsaved
		# node doesn't immediately reappear on the next snapshot. If it was promoted
		# into the live pool (active_saved), drop it there too (that DOES need a reload).
		tag=$(printf '%s' "$input" | jq -r '.tag // ""')
		MAP=/etc/vpnpool/saved.map.json
		[ -f "$MAP" ] || echo '{}' > "$MAP"
		link=$(saved_link_for_tag "$tag")
		[ -n "$tag" ] && [ -n "$link" ] || { rep false not_found; exit 0; }
		jq --arg t "$tag" 'del(.[$t])' "$MAP" > "$MAP.tmp" 2>/dev/null && mv "$MAP.tmp" "$MAP"
		[ -f "$SNAP_MAP" ] && { jq --arg t "$tag" 'del(.[$t])' "$SNAP_MAP" > "$SNAP_MAP.tmp" 2>/dev/null && mv "$SNAP_MAP.tmp" "$SNAP_MAP"; }
		reload=0
		if in_list vpnpool.main.active_saved "$link"; then
			uci del_list vpnpool.main.active_saved="$link"; reload=1
		fi
		rebuild_saved_list                      # commits vpnpool (incl. the del_list above)
		d=n/a; [ "$reload" = 1 ] && d=$(signal_word USR1)
		rep true deleted "$d"
		;;
	activate_saved)
		# promote an archived (inactive) saved node into the live active pool.
		tag=$(printf '%s' "$input" | jq -r '.tag // ""')
		link=$(saved_link_for_tag "$tag")
		if [ -n "$tag" ] && [ -n "$link" ]; then
			# If this node had been deleted (its link excluded), un-exclude it so activating
			# the saved copy actually brings it back — otherwise build.sh would filter it out.
			uci del_list vpnpool.main.excluded_node="$link" 2>/dev/null
			in_list vpnpool.main.active_saved "$link" || uci add_list vpnpool.main.active_saved="$link"
			uci commit vpnpool
			rep true saved "$(signal_word USR1)"
		else
			rep false not_found
		fi
		;;
	deactivate_saved)
		# demote a promoted saved node back to the inactive archive (stays saved).
		tag=$(printf '%s' "$input" | jq -r '.tag // ""')
		link=$(saved_link_for_tag "$tag")
		[ -n "$link" ] || link=$(jq -r --arg t "$tag" 'map(select(.tag==$t)) | .[0].link // ""' /etc/vpnpool/links.json 2>/dev/null)
		{ [ -n "$tag" ] && [ -n "$link" ] && in_list vpnpool.main.active_saved "$link"; } || { rep false not_found; exit 0; }
		uci del_list vpnpool.main.active_saved="$link" 2>/dev/null; uci commit vpnpool
		rep true saved "$(signal_word USR1)"
		;;
	node_link)
		# return the original vless:// (etc.) link for a node tag, for share/QR.
		# Falls back to the saved archive so inactive saved nodes can still be shared.
		tag=$(printf '%s' "$input" | jq -r '.tag // ""')
		LINKS=/etc/vpnpool/links.json
		link=""
		[ -n "$tag" ] && [ -f "$LINKS" ] && link=$(jq -r --arg t "$tag" 'map(select(.tag==$t)) | .[0].link // ""' "$LINKS" 2>/dev/null)
		[ -n "$tag" ] && [ -z "$link" ] && link=$(saved_link_for_tag "$tag")
		X=$(jq -nc --arg l "$link" '{link:$l}')
		if [ -n "$link" ]; then rep true ok n/a "$X"; else rep false not_found n/a "$X"; fi
		;;
	export_nodes)
		# export a set of node links as a JSON array (the browser turns it into a
		# base64 subscription). scope: saved | manual | imported | all.
		scope=$(printf '%s' "$input" | jq -r '.scope // "all"')
		LINKS=/etc/vpnpool/links.json
		case "$scope" in saved|manual|imported|all) ;; *) rep false invalid n/a '{"errors":{"scope":"bad_value"},"links":[]}'; exit 0 ;; esac
		case "$scope" in
		saved)
			# the canonical saved set = manual stars (saved.map) UNION auto-snapshot
			# (snapshot.map), already merged into the uci saved_node list by
			# rebuild_saved_list — the SAME set the dashboard marks with a star. Reading
			# only saved.map.json here missed every auto-snapshot node (export showed
			# "none" while stars were visible). Links are URLs (no spaces) -> safe to split.
			uci -q get vpnpool.main.saved_node | tr ' ' '\n' | grep '://' | jq -R . | jq -s 'unique' 2>/dev/null || echo '[]'
			;;
		manual|imported)
			opt=$([ "$scope" = manual ] && echo manual_node || echo imported_node)
			uci -q get vpnpool.main."$opt" | tr ' ' '\n' | grep '://' | jq -R . | jq -s '.' 2>/dev/null || echo '[]'
			;;
		*)
			[ -f "$LINKS" ] && jq -c '[.[].link] | map(select(. != null and . != "")) | unique' "$LINKS" 2>/dev/null || echo '[]'
			;;
		esac | jq -c '{ ok: ((.|length) > 0), code: (if length > 0 then "ok" else "empty" end), daemon: "n/a", links: . }
			| if .ok then . else . + {error: .code} end'
		;;
	add_sub)
		# extra FULL subscription (bulk-merged into the pool, unlike probe-only sources).
		# One quick validation fetch FIRST, so a typo / unreachable URL (e.g. a panel port
		# blocked from the router) is reported (fetch_failed) instead of silently adding
		# nothing; then add (dedup) + the daemon's full refetch (USR2) in the background.
		# parser.uc auto-detects base64/JSON/link-list. Short timeout keeps us inside the
		# rpcd call budget.
		u=$(printf '%s' "$input" | jq -r '.url // ""')
		case "$u" in
			http://*|https://*) case "$u" in *[[:space:]]*) rep false invalid n/a '{"errors":{"url":"bad_url"}}'; exit 0 ;; esac ;;
			*) rep false invalid n/a '{"errors":{"url":"bad_url"}}'; exit 0 ;;
		esac
		apply_add "$(jq -nc --arg u "$u" '{items:[$u]}')" | jq -c '
			(.probes[0] // {fetched:0, http:"000"}) as $p
			| {fetched: $p.fetched, http: $p.http, daemon}
			+ (if .added > 0 then {ok:true, code:"added"}
			   elif .dup > 0 then {ok:true, code:"already_exists"}
			   elif (.failed[0].reason // "") == "fetch_failed" then {ok:false, code:"fetch_failed", error:"fetch_failed"}
			   else {ok:false, code:"invalid", error:"invalid", errors:{url:"bad_url"}} end)'
		;;
	del_sub)
		need_url extra_sub "$(printf '%s' "$input" | jq -r '.url // ""')" 1; u=$U
		uci del_list vpnpool.main.extra_sub="$u" 2>/dev/null; uci commit vpnpool
		rep true deleted "$(signal_word USR2)"
		;;
	set_schedule)
		# HH:MM checked by the common validator (00:00..23:59; empty = no job); the crontab
		# is rewritten on every save (sched.sh), its exit code is the reply.
		FORCE_SCHED=1 apply_cfg --single "$(printf '%s' "$input" | jq -c '{
			sched_enabled: (if .enabled == null then false else .enabled end),
			sched_on: (.on // ""), sched_off: (.off // ""), sched_refresh: (.refresh // "")}')"
		;;
	unlock)
		# per-node service-unblock test — background (flips egress briefly), poll unlock_result.
		tag=$(printf '%s' "$input" | jq -r '.tag // ""')
		[ -n "$tag" ] || { rep false invalid n/a '{"errors":{"tag":"bad_tag"}}'; exit 0; }
		node_known "$tag" || { rep false not_found; exit 0; }
		mkdir -p /tmp/vpnpool
		clear_stale_lock /tmp/vpnpool/.unlock-running 180   # don't let a killed unlock block forever
		if [ -f /tmp/vpnpool/.unlock-running ]; then rep true already_running n/a '{"running":true,"already":true}'; exit 0; fi
		: > /tmp/vpnpool/.unlock-running
		rm -f /tmp/vpnpool/.unlock-result.json
		setsid sh -c '/usr/libexec/vpnpool/unlock.sh "$1"; rm -f /tmp/vpnpool/.unlock-running' _ "$tag" >/dev/null 2>&1 &
		echo $! > /tmp/vpnpool/.unlock-running   # record worker PID -> clear_stale_lock frees it the instant it dies
		rep true started n/a '{"running":true,"started":true}'
		;;
	unlock_result)
		job_result /tmp/vpnpool/.unlock-running /tmp/vpnpool/.unlock-result.json
		;;
	add_auto_domain)
		# manual "this site is blocked" -> add to the adaptive proxy-route list
		d=$(ucode "$API" check_domain "$(printf '%s' "$input" | jq -r '.domain // ""')" 2>/dev/null) \
			|| { rep false invalid n/a '{"errors":{"domain":"bad_domain"}}'; exit 0; }
		if in_list vpnpool.routing.auto_domain "$d"; then rep true already_exists; exit 0; fi
		uci add_list vpnpool.routing.auto_domain="$d"; uci commit vpnpool
		rep true added "$(signal_word USR1)"
		;;
	del_auto_domain)
		d=$(printf '%s' "$input" | jq -r '.domain // ""')
		{ [ -n "$d" ] && in_list vpnpool.routing.auto_domain "$d"; } || { rep false not_found; exit 0; }
		uci del_list vpnpool.routing.auto_domain="$d" 2>/dev/null; uci commit vpnpool
		rep true deleted "$(signal_word USR1)"
		;;
	run_adaptive)
		# trigger one adaptive-routing scan now (background)
		[ "$(uci -q get vpnpool.main.adaptive_routing)" = 1 ] || { rep false disabled; exit 0; }
		setsid sh -c '/usr/libexec/vpnpool/adaptive.sh' >/dev/null 2>&1 &
		rep true started n/a '{"started":true}'
		;;
	speedtest)
		# real throughput test for ONE node — runs in the background (it briefly
		# routes router traffic through the node), poll speedtest_result.
		tag=$(printf '%s' "$input" | jq -r '.tag // ""')
		[ -n "$tag" ] || { rep false invalid n/a '{"errors":{"tag":"bad_tag"}}'; exit 0; }
		node_known "$tag" || { rep false not_found; exit 0; }
		# Low-memory guard: on a 16 MB router an extra curl+jq burst can push an
		# already-tight box into OOM and kill sing-box. Refuse unless there is at least
		# speedtest_min_mem_kb of available RAM.
		MINKB=$(uci -q get vpnpool.main.speedtest_min_mem_kb); [ -n "$MINKB" ] || MINKB=8192
		AVAIL=$(awk '/^MemAvailable:/{print $2; found=1} END{if(!found) exit 1}' /proc/meminfo 2>/dev/null)
		[ -n "$AVAIL" ] || AVAIL=$(awk '/^MemFree:/{f=$2}/^Buffers:/{b=$2}/^Cached:/{c=$2}END{print f+b+c}' /proc/meminfo 2>/dev/null)
		if [ -n "$AVAIL" ] && [ "$AVAIL" -lt "$MINKB" ]; then
			rep false low_memory n/a "{\"lowmem\":true,\"avail_kb\":${AVAIL:-0},\"need_kb\":$MINKB}"; exit 0
		fi
		mkdir -p /tmp/vpnpool
		clear_stale_lock /tmp/vpnpool/.speedtest-running 180   # don't let a killed test block forever
		if [ -f /tmp/vpnpool/.speedtest-running ]; then rep true already_running n/a '{"running":true,"already":true}'; exit 0; fi
		: > /tmp/vpnpool/.speedtest-running
		rm -f /tmp/vpnpool/.speedtest-result.json
		setsid sh -c '/usr/libexec/vpnpool/speedtest.sh "$1"; rm -f /tmp/vpnpool/.speedtest-running' _ "$tag" >/dev/null 2>&1 &
		echo $! > /tmp/vpnpool/.speedtest-running   # record worker PID -> clear_stale_lock frees it the instant it dies
		rep true started n/a '{"running":true,"started":true}'
		;;
	speedtest_result)
		job_result /tmp/vpnpool/.speedtest-running /tmp/vpnpool/.speedtest-result.json
		;;
	backup)
		# FULL backup WITH secrets (write ACL): tar.gz of /etc/config/vpnpool +
		# /etc/vpnpool/awg/*.conf + /etc/vpnpool/*.map.json, returned inline as base64 in
		# .data (busybox may lack base64 — api.uc encodes) with a suggested file .name; the
		# browser turns it into a download (Blob). Nothing is kept on the router.
		D=/tmp/vpnpool/.backup; rm -rf "$D"; mkdir -p "$D/save"
		# shellcheck disable=SC2046
		if ! tar -czf "$D/b.tar.gz" -C / $(backup_members) 2>/dev/null; then
			rm -rf "$D"; rep false script_failed n/a '{"message":"tar"}'; exit 0
		fi
		# report = what IS in the archive (awg: its members), plus what was left out (skipped)
		REP=$(cfg_report /etc/config "$D/save" /etc/vpnpool/awg | jq -c --arg s "$(backup_scan | sed -n 's/^skip //p')" \
			--argjson a "$(backup_members | grep -c '^etc/vpnpool/awg/')" \
			'. + {awg: $a, skipped: ($s | split("\n") | map(select(length > 0)))}')
		ucode "$API" backup_reply "$D/b.tar.gz" "vpnpool-backup-$(date +%Y%m%d-%H%M).tar.gz" "$REP" 2>/dev/null \
			|| rep false script_failed n/a '{"message":"api.uc backup_reply"}'
		rm -rf "$D"
		;;
	restore)
		# Restore a backup() archive: {data: base64 tar.gz | path: /tmp/<file>, replace_all: true}. Unpacked into a
		# scratch dir and CHECKED first: only the backup's own members (no other path, no
		# symlink), the config parses and is complete (uci -c), maps are JSON, every .conf
		# parses to an AmneziaWG/WireGuard node. Without replace_all:true nothing changes and
		# the reply is confirm_required + the report {nodes, subscriptions, saved, awg,
		# settings} — the UI shows it and asks "replace everything?". With it: the current
		# state is kept in RAM (/tmp/vpnpool/pre-restore.tar.gz), the config, the AWG files
		# and the maps are REPLACED (not merged), then init.d reload + refetch (USR2).
		D=/tmp/vpnpool/.restore; rm -rf "$D"; mkdir -p "$D/root" "$D/save"
		bad() { rm -rf "$D"; rep false "$1" n/a "${2:-null}"; exit 0; }
		# the archive: inline base64 (.data) or a file LuCI uploaded to /tmp (.path, e.g. via
		# cgi-upload — for archives too big for one JSON-RPC request). The path must be IN /tmp
		# after every symlink is resolved.
		src=$(printf '%s' "$input" | jq -r '.path // ""')
		if [ -n "$src" ]; then
			real=$(readlink -f "$src" 2>/dev/null)
			case "$real" in /tmp/?*) ;; *) bad invalid '{"errors":{"path":"bad_value"}}' ;; esac
			[ -f "$real" ] || bad invalid '{"errors":{"path":"bad_value"}}'
			[ "$(wc -c < "$real")" -le "$RESTORE_MAX_BYTES" ] || bad too_large
			cp "$real" "$D/a.tar.gz" || bad invalid '{"errors":{"path":"bad_value"}}'
		else
			printf '%s' "$input" | ucode "$API" b64dec_field data "$D/a.tar.gz" 2>/dev/null || bad invalid '{"errors":{"data":"bad_value"}}'
			[ "$(wc -c < "$D/a.tar.gz")" -le "$RESTORE_MAX_BYTES" ] || bad too_large
		fi
		# BEFORE unpacking: every member must be a regular file or a directory (no symlink,
		# hardlink, device, fifo), named by MEMBER_RE; count and total size within the limits.
		tar -tvzf "$D/a.tar.gz" > "$D/listv" 2>/dev/null || bad invalid_archive
		v=$(MEMBER_RE="$MEMBER_RE" awk -v maxb="$RESTORE_MAX_BYTES" -v maxn="$RESTORE_MAX_FILES" '
			BEGIN { re = ENVIRON["MEMBER_RE"]; bad = "" }
			{ n++; t = substr($1, 1, 1)
			  if (NF != 6 || (t != "-" && t != "d") || $6 !~ re) { bad = "invalid_archive"; exit }
			  sum += $3 }
			END { if (bad != "") print bad; else if (n == 0) print "invalid_archive";
			      else if (n > maxn || sum > maxb) print "too_large"; else print "ok" }' "$D/listv")
		[ "$v" = ok ] || bad "$v"
		tar -xzf "$D/a.tar.gz" -C "$D/root" 2>/dev/null || bad invalid_archive
		# and AFTER: what is on disk is what the listing promised
		[ -z "$(find "$D/root" ! -type f ! -type d 2>/dev/null)" ] || bad invalid_archive
		[ "$(find "$D/root" | wc -l)" -le "$((RESTORE_MAX_FILES + 1))" ] || bad too_large
		[ "$(du -sk "$D/root" | cut -f1)" -le "$((RESTORE_MAX_BYTES / 1024 + RESTORE_MAX_FILES * 4))" ] || bad too_large
		[ -f "$D/root/etc/config/vpnpool" ] || bad invalid_archive
		check_uci_dir "$D/root/etc/config" "$D/save" || bad incomplete_config
		# every VALUE through the set_config schema: a restored config must not break the daemon
		CC=$(ucode "$API" check_config "$D/root/etc/config" "$D/save" 2>/dev/null)
		if [ "$(printf '%s' "$CC" | jq -r '.ok' 2>/dev/null)" != true ]; then
			[ -n "$CC" ] || CC='{"ok":false,"code":"invalid"}'
			rm -rf "$D"; printf '%s' "$CC" | finish n/a; exit 0
		fi
		for f in "$D"/root/etc/vpnpool/*.map.json; do
			[ -f "$f" ] || continue
			jq -e 'type=="object"' "$f" >/dev/null 2>&1 || bad invalid_archive
		done
		for f in "$D"/root/etc/vpnpool/awg/*.conf; do
			[ -f "$f" ] || continue
			ucode "$PARSER" "$f" 2>/dev/null | jq -e '.[0].type=="awg" or .[0].type=="wireguard"' >/dev/null 2>&1 || bad invalid_archive
		done
		REP=$(cfg_report "$D/root/etc/config" "$D/save" "$D/root/etc/vpnpool/awg")
		if [ "$(printf '%s' "$input" | jq -r '.replace_all == true' 2>/dev/null)" != true ]; then
			rm -rf "$D"; rep false confirm_required n/a "{\"report\":$REP}"; exit 0
		fi
		# 1. the state before, VERIFIED — without it nothing is replaced
		PRE=/tmp/vpnpool/pre-restore.tar.gz; rm -f "$PRE"
		# shellcheck disable=SC2046
		{ tar -czf "$PRE" -C / $(backup_members) 2>/dev/null && tar -tzf "$PRE" >/dev/null 2>&1; } \
			|| { rm -f "$PRE"; bad write_failed '{"step":"pre_copy"}'; }
		# 2. stage the new files on the SAME file system as their targets (the renames below are
		#    atomic); nothing live is touched yet
		NEW=/etc/vpnpool/.restore-new; OLD=/etc/vpnpool/.restore-old
		rm -rf "$NEW" "$OLD"; ok=1
		mkdir -p "$NEW/awg" "$OLD/awg" /etc/vpnpool/awg || ok=0
		for f in "$D"/root/etc/vpnpool/awg/*.conf; do [ -f "$f" ] || continue; cp "$f" "$NEW/awg/" || ok=0; done
		for f in "$D"/root/etc/vpnpool/$BACKUP_MAPS; do [ -f "$f" ] || continue; cp "$f" "$NEW/" || ok=0; done
		cp "$D/root/etc/config/vpnpool" "$NEW/config" || ok=0
		if [ "$ok" = 0 ]; then
			rm -rf "$NEW" "$OLD"; bad restore_failed "{\"step\":\"stage\",\"rolled_back\":true,\"backup\":\"$PRE\"}"
		fi
		# 3. swap: the live members aside (files other than backup members stay where they are),
		#    the new ones in, the config LAST. Every move is recorded for the rollback.
		: > "$OLD/.moved"; : > "$OLD/.placed"
		for f in $(backup_members); do
			[ "$f" = etc/config/vpnpool ] && continue
			rel=${f#etc/vpnpool/}
			if mv -f "/$f" "$OLD/$rel"; then echo "$rel" >> "$OLD/.moved"; else ok=0; break; fi
		done
		if [ "$ok" = 1 ]; then
			for f in "$NEW"/awg/*.conf "$NEW"/$BACKUP_MAPS; do
				[ -f "$f" ] || continue
				rel=${f#"$NEW"/}
				if mv -f "$f" "/etc/vpnpool/$rel"; then echo "$rel" >> "$OLD/.placed"; else ok=0; break; fi
			done
		fi
		if [ "$ok" = 1 ]; then
			uci -q revert vpnpool
			mv -f "$NEW/config" /etc/config/vpnpool || ok=0
		fi
		if [ "$ok" = 0 ]; then
			# rollback: take the placed files out, put the moved ones back; if that fails too,
			# unpack the verified copy taken before. The config was not replaced (last step).
			rb=1
			while IFS= read -r rel; do rm -f "/etc/vpnpool/$rel" || rb=0; done < "$OLD/.placed"
			while IFS= read -r rel; do mv -f "$OLD/$rel" "/etc/vpnpool/$rel" || rb=0; done < "$OLD/.moved"
			[ "$rb" = 1 ] || { tar -xzf "$PRE" -C / 2>/dev/null && rb=1; }
			rm -rf "$NEW" "$OLD" "$D"
			rep false restore_failed n/a "$(jq -nc --argjson r "$([ "$rb" = 1 ] && echo true || echo false)" --arg b "$PRE" '{step:"swap", rolled_back:$r, backup:$b}')"
			exit 0
		fi
		rm -rf "$NEW" "$OLD" "$D"
		# enabled / Telegram may differ now: procd re-reads both instances; then refetch
		/etc/init.d/vpnpool reload >/dev/null 2>&1
		rep true restored "$(signal_word USR2)" "{\"report\":$REP}"
		;;
	*)
		rep false unknown_method
		;;
	esac
	;;
esac
