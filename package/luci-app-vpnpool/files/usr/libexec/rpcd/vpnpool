				why=$(printf '%s' "$res" | jq -c '.failed[0] // {}')
				case "$(printf '%s' "$why" | jq -r '.reason // ""')" in
					decode_failed|api_key|full_access|unsupported_container|no_conf)
						rep false decode_failed n/a "$(printf '%s' "$why" | jq -c '{reason}')" ;;
					*)	rep false invalid n/a "$(printf '%s' "$why" | jq -c '{reason:(.reason // "bad_awg_config")} + (if .field then {field} else {} end)')" ;;
