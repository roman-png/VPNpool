#: files/www/luci-static/resources/view/vpnpool/dashboard.js:110
msgid "%s/s"
msgstr "%s/с"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:120
msgid "Not started: the settings of the previous version could not be converted"
msgstr "Не запущен: настройки прошлой версии не удалось перенести"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:121
msgid "Nothing was changed. Open Diagnostics to see why."
msgstr "Ничего не изменено. Причина — в «Диагностике»."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:122
msgid "VPN is off"
msgstr "VPN выключен"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:122
msgid "The internet goes directly, without the VPN."
msgstr "Интернет идёт напрямую, без VPN."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:125
msgid "VPN is on, but the service is not running"
msgstr "VPN включён, но служба не работает"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:126
msgid "Press \"Turn the VPN on\"; if it repeats, open Diagnostics."
msgstr "Нажмите «Включить VPN»; если повторится, откройте «Диагностику»."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:127
msgid "Turn the VPN off and on again; if it repeats, open Diagnostics."
msgstr "Выключите и снова включите VPN; если повторится, откройте «Диагностику»."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:128
msgid "Paused"
msgstr "Пауза"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:129
msgid "Paused from Telegram: the internet goes directly, without the VPN. \"Turn the VPN on\" resumes it."
msgstr "Пауза из Telegram: интернет идёт напрямую, без VPN. «Включить VPN» возвращает его."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:130
msgid "The router has no internet"
msgstr "У роутера нет интернета"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:131
msgid "What should go through the VPN is blocked until the internet is back."
msgstr "То, что должно идти через VPN, заблокировано, пока интернет не вернётся."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:131
msgid "Check the cable or the internet provider."
msgstr "Проверьте кабель или провайдера."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:132
msgid "No node works"
msgstr "Ни один узел не работает"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:134
msgid "What should go through the VPN is blocked until a node works (protection is on)."
msgstr "То, что должно идти через VPN, заблокировано, пока не заработает узел (включена защита)."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:137
msgid "If no node works again in a moment, what should go through the VPN goes directly."
msgstr "Если ни один узел вскоре не заработает, то, что должно идти через VPN, пойдёт напрямую."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:138
msgid "What should go through the VPN goes directly until a node works."
msgstr "То, что должно идти через VPN, идёт напрямую, пока не заработает узел."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:140
msgid "VPN works"
msgstr "VPN работает"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:140
#: files/www/luci-static/resources/view/vpnpool/routing.js:203
msgid "Everything except the chosen sites"
msgstr "Всё, кроме выбранных сайтов"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:140
#: files/www/luci-static/resources/view/vpnpool/routing.js:201
msgid "Only the chosen sites"
msgstr "Только выбранные сайты"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:141
msgid "The VPN works, but the traffic does not go through it"
msgstr "VPN работает, но трафик через него не идёт"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:141
msgid "The routes could not be set up. Open Diagnostics."
msgstr "Не удалось настроить маршруты. Откройте «Диагностику»."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:142
msgid "Starting…"
msgstr "Запуск…"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:142
msgid "Looking for a working node."
msgstr "Ищем рабочий узел."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:143
msgid "VPN is on"
msgstr "VPN включён"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:143
msgid "Checking that the nodes work…"
msgstr "Проверяем, что узлы работают…"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:152
msgid "There is not a single node: the subscriptions could not be downloaded or have no nodes."
msgstr "Нет ни одного узла: подписки не скачались или в них нет узлов."

