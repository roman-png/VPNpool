msgid "VPN is on, but the service is not running"
msgstr "VPN включён, но служба не работает"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:115
msgid "Turn the VPN off and on again; if it repeats, open Diagnostics."
msgstr "Выключите и снова включите VPN; если повторится, откройте «Диагностику»."

