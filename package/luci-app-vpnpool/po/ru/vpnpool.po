#: files/www/luci-static/resources/view/vpnpool/settings.js:110
msgid "The backup is downloaded. Nodes: %d, subscriptions: %d, favourites: %d."
msgstr "Резервная копия скачана. Узлов: %d, подписок: %d, избранных: %d."

#: files/www/luci-static/resources/view/vpnpool/settings.js:124
msgid "This file is too large to upload through the page: at most %d KB."
msgstr "Этот файл слишком большой для загрузки через страницу: можно не больше %d КБ."

#: files/www/luci-static/resources/view/vpnpool/settings.js:136
msgid "Nodes: %d"
msgstr "Узлов: %d"

#: files/www/luci-static/resources/view/vpnpool/settings.js:137
