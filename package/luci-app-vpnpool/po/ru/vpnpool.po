msgstr "Загрузка и пинг узлов — до минуты на медленных роутерах."

#: files/www/luci-static/resources/view/vpnpool/sources.js:203
msgid "No usable nodes from this source"
msgstr "Из этого источника нет пригодных узлов"

#: files/www/luci-static/resources/view/vpnpool/sources.js:213
