msgid "VPN Pool — Sources"
msgstr "VPN Pool — Источники"

#: files/www/luci-static/resources/view/vpnpool/sources.js:309
msgid "Main subscription"
msgstr "Основная подписка"

#: files/www/luci-static/resources/view/vpnpool/sources.js:312
msgid "Save URL"
msgstr "Сохранить URL"

#: files/www/luci-static/resources/view/vpnpool/sources.js:313
msgid "Delete subscription"
msgstr "Удалить подписку"

#: files/www/luci-static/resources/view/vpnpool/sources.js:317
msgid "Auto-update interval"
msgstr "Интервал автообновления"

#: files/www/luci-static/resources/view/vpnpool/sources.js:319
