#: files/www/luci-static/resources/view/vpnpool/settings.js:196
msgid "Failures in a row before dropping"
msgstr "Неудач подряд до отсева"

#: files/www/luci-static/resources/view/vpnpool/settings.js:197
msgid "Retries per check"
msgstr "Повторов на проверку"

#: files/www/luci-static/resources/view/vpnpool/settings.js:198
msgid "A node counts as reaching a service if any of these back-to-back attempts succeeds — absorbs the intermittent cold-handshake flakiness of Reality/Vision nodes so a usable node isn’t wrongly dropped. Default 3."
msgstr "Узел считается достигшим сервиса, если успешна хотя бы одна из попыток подряд — сглаживает перемежающуюся флакость «холодного» хендшейка Reality/Vision-узлов, чтобы рабочий узел не отсеялся по ошибке. По умолчанию 3."

#: files/www/luci-static/resources/view/vpnpool/settings.js:205
msgid "Security / leak protection"
msgstr "Безопасность / защита от утечек"

#: files/www/luci-static/resources/view/vpnpool/settings.js:207
msgid "Kill-switch (block all traffic if VPN is down)"
msgstr "Kill-switch (блокировать весь трафик, если VPN недоступен)"

#: files/www/luci-static/resources/view/vpnpool/settings.js:211
msgid "DNS-leak protection (route LAN DNS through the tunnel)"
msgstr "Защита от DNS-утечек (DNS из LAN через туннель)"

#: files/www/luci-static/resources/view/vpnpool/settings.js:214
msgid "Kill-switch fails closed in full-tunnel (exclude) mode. DNS protection sends LAN DNS queries through the VPN so they can’t leak to your ISP."
msgstr "Kill-switch работает в режиме полного туннеля (исключения): при падении VPN трафик не уходит напрямую. Защита DNS отправляет DNS-запросы LAN через VPN, чтобы они не утекали провайдеру."

#: files/www/luci-static/resources/view/vpnpool/settings.js:218
msgid "Anti-DPI & adaptive routing"
msgstr "Анти-DPI и адаптивная маршрутизация"

#: files/www/luci-static/resources/view/vpnpool/settings.js:219
msgid "Anti-DPI (TLS fragmentation)"
msgstr "Анти-DPI (фрагментация TLS)"

#: files/www/luci-static/resources/view/vpnpool/settings.js:221
msgid "Splits the TLS handshake so plaintext-SNI DPI can not match it. Defeats BASIC filtering only — not robust censorship (for TSPU/strong DPI use zapret). Needs sing-box ≥ 1.12; ignored if unsupported."
msgstr "Разбивает TLS-хендшейк, чтобы DPI по открытому SNI не мог его сопоставить. Помогает только против БАЗОВОЙ фильтрации — не против устойчивой цензуры (для TSPU/сильного DPI нужен zapret). Требуется sing-box ≥ 1.12; игнорируется, если не поддерживается."

#: files/www/luci-static/resources/view/vpnpool/settings.js:222
msgid "Adaptive routing: auto-route sites that are blocked for a direct connection"
msgstr "Адаптивная маршрутизация: авто-направлять в VPN сайты, заблокированные напрямую"

#: files/www/luci-static/resources/view/vpnpool/settings.js:224
msgid "Scan now"
msgstr "Сканировать сейчас"

#: files/www/luci-static/resources/view/vpnpool/settings.js:226
msgid "Site is blocked?"
msgstr "Сайт заблокирован?"

#: files/www/luci-static/resources/view/vpnpool/settings.js:227
msgid "Route via VPN"
msgstr "Направить в VPN"

#: files/www/luci-static/resources/view/vpnpool/settings.js:229
msgid "Auto-routed domains"
msgstr "Авто-маршрутизированные домены"

#: files/www/luci-static/resources/view/vpnpool/settings.js:234
msgid "Auto-save working nodes"
msgstr "Авто-сохранение рабочих узлов"

#: files/www/luci-static/resources/view/vpnpool/settings.js:235
msgid "Periodically snapshot reachable nodes to the saved store"
msgstr "Периодически сохранять доступные узлы в постоянную память"

#: files/www/luci-static/resources/view/vpnpool/settings.js:236
msgid "Keep at most (nodes)"
msgstr "Хранить не более (узлов)"

#: files/www/luci-static/resources/view/vpnpool/settings.js:240
msgid "Builds a fallback set that survives subscription expiry. Manual ⭐ saves are never evicted."
msgstr "Формирует резервный набор, который остаётся после окончания подписки. Ручные ⭐ никогда не вытесняются."

#: files/www/luci-static/resources/view/vpnpool/settings.js:244
msgid "Schedule"
msgstr "Расписание"

#: files/www/luci-static/resources/view/vpnpool/settings.js:245
msgid "Enable schedule"
msgstr "Включить расписание"

#: files/www/luci-static/resources/view/vpnpool/settings.js:246
msgid "Turn ON at (HH:MM)"
msgstr "Включать в (ЧЧ:ММ)"

#: files/www/luci-static/resources/view/vpnpool/settings.js:247
msgid "Turn OFF at (HH:MM)"
msgstr "Выключать в (ЧЧ:ММ)"

#: files/www/luci-static/resources/view/vpnpool/settings.js:248
msgid "Refresh subscription at (HH:MM)"
msgstr "Обновлять подписку в (ЧЧ:ММ)"

#: files/www/luci-static/resources/view/vpnpool/settings.js:252
msgid "Router local time. Leave a field empty to skip that action. Uses cron."
msgstr "Локальное время роутера. Пустое поле — действие пропускается. Использует cron."

#: files/www/luci-static/resources/view/vpnpool/settings.js:256
msgid "Telegram alerts & control"
msgstr "Telegram: уведомления и управление"

#: files/www/luci-static/resources/view/vpnpool/settings.js:257
msgid "Enable Telegram notifications"
msgstr "Включить уведомления в Telegram"

#: files/www/luci-static/resources/view/vpnpool/settings.js:258
msgid "Bot token"
msgstr "Токен бота"

#: files/www/luci-static/resources/view/vpnpool/settings.js:259
msgid "Chat ID"
msgstr "Chat ID"

#: files/www/luci-static/resources/view/vpnpool/settings.js:260
msgid "Two-way control bot (/status, /nodes, /switch, /on, /off, /refresh)"
msgstr "Двусторонний бот управления (/status, /nodes, /switch, /on, /off, /refresh)"

#: files/www/luci-static/resources/view/vpnpool/settings.js:261
msgid "Reach Telegram through the tunnel (needed where Telegram is blocked)"
msgstr "Доступ к Telegram через туннель (нужно там, где Telegram заблокирован)"

#: files/www/luci-static/resources/view/vpnpool/settings.js:264
msgid "Send test"
msgstr "Тест"

#: files/www/luci-static/resources/view/vpnpool/settings.js:266
msgid "Create a bot via @BotFather, get your chat id (e.g. @userinfobot). Alerts: failover, subscription expiry, start/stop. The control bot only obeys your chat id."
msgstr "Создайте бота через @BotFather, узнайте chat id (напр. @userinfobot). Алерты: переключение узла, истечение подписки, старт/стоп. Бот управления слушает только ваш chat id."

#: files/www/luci-static/resources/view/vpnpool/settings.js:269
msgid "Backup / Restore"
msgstr "Бэкап / Восстановление"

#: files/www/luci-static/resources/view/vpnpool/settings.js:275
msgid "Export fills the box with your config — copy it somewhere safe. Paste a backup and Import to restore."
msgstr "Экспорт заполнит поле вашей конфигурацией — сохраните её. Вставьте бэкап и нажмите Импорт для восстановления."

#: files/www/luci-static/resources/view/vpnpool/settings.js:278
msgid "Technical (read-only)"
msgstr "Технические (только чтение)"

#: files/www/luci-static/resources/view/vpnpool/settings.js:281
msgid "fwmark"
msgstr "fwmark"

#: files/www/luci-static/resources/view/vpnpool/settings.js:282
msgid "route table"
msgstr "таблица маршрутов"

#: files/www/luci-static/resources/view/vpnpool/settings.js:284
msgid "These coexist with podkop (mark 0x100000, table podkop, :1602) and must not collide."
msgstr "Сосуществуют с podkop (mark 0x100000, table podkop, :1602) и не должны пересекаться."

