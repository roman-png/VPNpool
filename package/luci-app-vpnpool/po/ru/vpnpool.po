msgid "%d node fails the check of the sites (%s): it is left out of the automatic choice."
msgid_plural "%d nodes fail the check of the sites (%s): they are left out of the automatic choice."
msgstr[0] "%d узел не проходит проверку сайтов (%s): он не участвует в автовыборе."
msgstr[1] "%d узла не проходят проверку сайтов (%s): они не участвуют в автовыборе."
msgstr[2] "%d узлов не проходят проверку сайтов (%s): они не участвуют в автовыборе."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:163
msgid "%d node fails the connection check: it is left out of the automatic choice."
msgid_plural "%d nodes fail the connection check: they are left out of the automatic choice."
msgstr[0] "%d узел не проходит проверку связи: он не участвует в автовыборе."
msgstr[1] "%d узла не проходят проверку связи: они не участвуют в автовыборе."
msgstr[2] "%d узлов не проходят проверку связи: они не участвуют в автовыборе."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:168
msgid "%d AmneziaWG node waits for the AmneziaWG engine: it starts working once the engine is installed."
msgid_plural "%d AmneziaWG nodes wait for the AmneziaWG engine: they start working once the engine is installed."
msgstr[0] "%d узел AmneziaWG ждёт движок AmneziaWG: заработает, как только движок будет установлен."
msgstr[1] "%d узла AmneziaWG ждут движок AmneziaWG: заработают, как только движок будет установлен."
msgstr[2] "%d узлов AmneziaWG ждут движок AmneziaWG: заработают, как только движок будет установлен."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:169
msgid "How to install it"
msgstr "Как установить"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:172
msgid "%d node was set aside: the VPN engine could not start with it."
msgid_plural "%d nodes were set aside: the VPN engine could not start with them."
msgstr[0] "%d узел отложен: движок VPN не смог с ним запуститься."
msgstr[1] "%d узла отложены: движок VPN не смог с ними запуститься."
msgstr[2] "%d узлов отложено: движок VPN не смог с ними запуститься."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:175
msgid "%d AmneziaWG settings file could not be read."
msgid_plural "%d AmneziaWG settings files could not be read."
msgstr[0] "%d файл настроек AmneziaWG не удалось прочитать."
msgstr[1] "%d файла настроек AmneziaWG не удалось прочитать."
msgstr[2] "%d файлов настроек AmneziaWG не удалось прочитать."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:200
