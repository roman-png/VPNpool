#: files/www/luci-static/resources/view/vpnpool/dashboard.js:111
msgid "Not started: the settings of the previous version could not be converted"
msgstr "Не запущен: настройки прошлой версии не удалось перенести"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:112
msgid "Nothing was changed. Open Diagnostics to see why."
msgstr "Ничего не изменено. Причина — в «Диагностике»."

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:113
msgid "VPN is off"
msgstr "VPN выключен"

#: files/www/luci-static/resources/view/vpnpool/dashboard.js:113
msgid "The internet goes directly, without the VPN."
msgstr "Интернет идёт напрямую, без VPN."

