#: files/www/luci-static/resources/view/vpnpool/dashboard.js:160
msgid "%d node does not open %s: it is left out of the automatic choice."
msgid_plural "%d nodes do not open %s: they are left out of the automatic choice."
msgstr[0] "%d узел не открывает %s: он не участвует в автовыборе."
msgstr[1] "%d узла не открывают %s: они не участвуют в автовыборе."
msgstr[2] "%d узлов не открывают %s: они не участвуют в автовыборе."

