#!/bin/sh
# Test double for curl (PATH-prepended by stand/tests/run.sh, also for rpcd's children).
# Active only while $MOCK_DIR/enabled exists; otherwise defers to the real curl.
#
# Rules: $MOCK_DIR/rules, one per line, TAB separated:
#   <key-glob>  <http_code>  <body-file|->  [<headers-file|->]  [<time_connect>]  [<sleep s>]
# key = "<METHOD> <url>" with "P " prepended when --proxy/-x is used, e.g.
#   GET https://sub.example/primary*          200  /tmp/f/primary.b64  /tmp/f/h.txt
#   P GET https://ifconfig.co/json            200  /tmp/f/ip.json
#   PUT http://127.0.0.1:9091/proxies/proxy   204  -
# First matching rule wins. No match => connection refused (http_code 000, exit 7): the
# stand runs without network, so an unexpected request is a visible failure, not a leak.
# Every call is appended to $MOCK_DIR/calls.log ("<key>\t<code>").
# Several transfers in one call (curl URL1 -o F1 URL2 -o F2, or URL1 URL2 to stdout) are
# answered in order, like curl: each URL pairs with the n-th -o, -w is printed per transfer.
MOCK_DIR=${MOCK_DIR:-/tmp/curlmock}
REAL=/usr/bin/curl
[ -f "$MOCK_DIR/enabled" ] || exec "$REAL" "$@"

wfmt=""; hdr=""; fail=0; proxy=""; method=GET; hasdata=0
nurl=0; nout=0
while [ $# -gt 0 ]; do
	case "$1" in
		-o|--output) nout=$((nout + 1)); eval "out_$nout=\$2"; shift ;;
		-w|--write-out) wfmt="$2"; shift ;;
		-D|--dump-header) hdr="$2"; shift ;;
		-x|--proxy) proxy="$2"; shift ;;
		-X|--request) method="$2"; shift ;;
		-d|--data|--data-raw|--data-binary|--data-urlencode|-F|--form) hasdata=1; shift ;;
		-A|--user-agent|-H|--header|-m|--max-time|--connect-timeout|-e|--referer|-u|--user|-b|--cookie|-c|--cookie-jar|--retry|-r|--range|--limit-rate|--resolve|--interface|--max-filesize) shift ;;
		-f|--fail) fail=1 ;;
		-*) case "$1" in -*f*) case "$1" in --*) ;; *) fail=1 ;; esac ;; esac ;;   # e.g. -sfL
		*) nurl=$((nurl + 1)); eval "url_$nurl=\$1" ;;
	esac
	shift
done
[ "$method" = GET ] && [ "$hasdata" = 1 ] && method=POST
TAB='	'
NL='
'

transfer() {   # $1=url $2=output file ("" = stdout) -> sets RC
	url="$1"; out="$2"
	key="$method $url"; [ -n "$proxy" ] && key="P $key"
	code=000; body=-; hfile=-; tconn=0; slp=0
	if [ -f "$MOCK_DIR/rules" ]; then
		while IFS="$TAB" read -r pat c b h t s; do
			[ -n "$pat" ] || continue
			case "$pat" in \#*) continue ;; esac
			# shellcheck disable=SC2254
			case "$key" in
				$pat) code="$c"; body="${b:--}"; hfile="${h:--}"; tconn="${t:-0.010}"; slp="${s:-0}"; break ;;
			esac
		done < "$MOCK_DIR/rules"
	fi
	printf '%s\t%s\n' "$key" "$code" >> "$MOCK_DIR/calls.log"
	[ "$slp" != 0 ] && sleep "$slp"
	[ -n "$hdr" ] && {
		if [ "$hfile" != - ] && [ -f "$hfile" ]; then cat "$hfile" > "$hdr"; else printf 'HTTP/1.1 %s\r\n\r\n' "$code" > "$hdr"; fi
	}
	if [ "$code" != 000 ]; then
		if [ "$fail" = 1 ] && [ "$code" -ge 400 ]; then :; else
			if [ "$body" != - ] && [ -f "$body" ]; then
				if [ -n "$out" ]; then cat "$body" > "$out"; else cat "$body"; fi
			fi
		fi
	fi
	if [ -n "$wfmt" ]; then
		[ "$code" = 000 ] && tc=0 || tc="$tconn"
		# size_download = body bytes; speed_download = the same number (as if it took 1 s)
		# (shell substitutions, not sed: the status suite counts the processes of a poll)
		sz=0
		case "$wfmt" in *size_download*|*speed_download*)
			[ "$code" != 000 ] && [ "$body" != - ] && [ -f "$body" ] && sz=$(wc -c < "$body" | tr -d ' ') ;;
		esac
		w=$wfmt
		w=${w//'%{http_code}'/$code}; w=${w//'%{time_connect}'/$tc}; w=${w//'%{time_total}'/$tc}
		w=${w//'%{size_download}'/$sz}; w=${w//'%{speed_download}'/$sz}; w=${w//'\n'/$NL}
		printf '%s' "$w"
	fi
	RC=0
	[ "$code" = 000 ] && RC=7
	[ "$fail" = 1 ] && [ "$code" -ge 400 ] && RC=22
	return 0
}

i=1; RC=7
while [ "$i" -le "$nurl" ]; do
	eval "_u=\$url_$i; _o=\${out_$i:-}"
	transfer "$_u" "$_o"
	i=$((i + 1))
done
exit "$RC"
