# vpnpool 1.4.1 configuration as a router has it after some use (the shape of the 1.4.1 package
# default + the stores the 1.x UI writes). Made-up subscriptions, credentials and documentation
# addresses — no real secrets. Used by stand/tests/suites/migrate.sh (1.x -> 2.0 migration).

config vpnpool 'main'
	option enabled '1'
	option mode 'selective'
	option subscription_url 'https://sub.example.com/sub/TOKENPRIMARY'
	list extra_sub 'https://extra.example.com/list/TOKENEXTRA'
	option subscription_ua 'MyPanelClient/2.1'
	option subscription_interval '6h'
	option health_url 'http://cp.cloudflare.com/generate_204'
	option check_services 'www.youtube.com'
	option failover_interval '60'
	option failover_tolerance '50'
	option auto_switch '1'
	option selected_node 'Sub-NL #2'
	option preferred_node 'Sub-DE'
	option ipv6 'block'
	option killswitch '1'
	option dns_protect '0'
	option client_mode 'exclude'
	list client '192.168.1.50'
	list client '192.168.1.51'
	list client_dev 'aa:bb:cc:dd:ee:01'
	list manual_node 'vless://11111111-2222-4333-8444-555555555501@203.0.113.11:443?security=tls&sni=own.example#My-Own'
	list source 'https://free.example.org/list.txt'
	list source 'https://empty.example.org/none.txt'
	list imported_node 'vless://11111111-2222-4333-8444-555555555502@203.0.113.12:443?security=tls&sni=free.example#Free-1'
	list imported_node 'vless://11111111-2222-4333-8444-555555555503@203.0.113.13:443?security=tls&sni=free.example#Orphan-Import'
	list saved_node 'vless://11111111-2222-4333-8444-555555555504@203.0.113.14:443?security=tls&sni=sub.example#Sub-DE'
	list saved_node 'vless://11111111-2222-4333-8444-555555555508@203.0.113.18:443?security=tls&sni=sub.example#Old-Saved'
	list saved_node 'vless://11111111-2222-4333-8444-555555555505@203.0.113.15:443?security=tls&sni=sub.example#Sub-NL'
	list saved_node 'vless://11111111-2222-4333-8444-555555555511@203.0.113.21:443?security=tls&sni=sub.example#Only-In-Uci'
	list active_saved 'vless://11111111-2222-4333-8444-555555555508@203.0.113.18:443?security=tls&sni=sub.example#Old-Saved'
	list excluded_node 'vless://11111111-2222-4333-8444-555555555507@203.0.113.17:443?security=tls&sni=sub.example#Sub-Bad'
	list auto_member 'Sub-DE'
	list auto_member 'Sub-NL #2'
	list auto_member 'Ghost-Node'
	list keep_auto 'Json-Node'
	option auto_snapshot '1'
	option auto_snapshot_max '20'
	option sched_enabled '1'
	option sched_on '07:30'
	option sched_off '23:45'
	option sched_refresh '04:10'
	option speedtest_url 'https://speed.cloudflare.com/__down?bytes=10000000'
	option antidpi 'off'
	option adaptive_routing '0'
	option adaptive_max_per_run '8'
	option speedtest_min_mem_kb '8192'
	option dead_filter '1'
	option dead_filter_strikes '3'
	option dead_filter_tries '3'
	option telegram_enabled '1'
	option telegram_token '123456:FAKE-TOKEN-FOR-TESTS'
	option telegram_chat '-1001234567'
	option telegram_control '1'
	option telegram_via_proxy '1'
	option fwmark '0x400000'
	option route_table '142'
	option route_priority '106'
	option tproxy_port '1603'
	option test_port '1605'
	option clash_api '127.0.0.1:9091'
	option singbox_config '/etc/vpnpool/sing-box.json'
	option log_level 'warn'
	option lan_if ''
	option coexist 'auto'

config routing 'routing'
	list community 'telegram'
	list community 'russia_inside'
	list domain 'example.org'
	list auto_domain 'blocked.example.net'
