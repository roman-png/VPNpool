# vpnpool stand — UI variant. Extends the base stand image with LuCI + uhttpd so the REAL
# web dashboard (the shipped luci-app JS views + rpcd backend) can be driven over HTTP.
#   docker build -f stand/Dockerfile -t vpnpool-stand .
#   docker build -f stand/Dockerfile.ui -t vpnpool-stand-ui .          (context = repo root)
#   (25.12: --build-arg BASE_IMAGE=vpnpool-stand:25.12 after building that base)
# Start + smoke check: see stand/USAGE.txt (stand/tests/ui-smoke.sh checks login, the
# admin/services/vpnpool page and `vpnpool status` through rpcd over HTTP).
ARG BASE_IMAGE=vpnpool-stand:latest
FROM ${BASE_IMAGE}

# LuCI JS framework + ubus-over-HTTP bridge + a theme + admin menu + rpcd ACL plumbing.
# No `|| true`: a missing package must fail the build, not produce a half-working UI.
RUN PKGS="uhttpd uhttpd-mod-ubus luci-base luci-theme-bootstrap luci-mod-admin-full rpcd-mod-luci rpcd-mod-file" \
 && if command -v apk >/dev/null 2>&1; then apk update && apk add $PKGS; \
    else opkg update && opkg install $PKGS; fi \
 && test -e /www/cgi-bin/luci && test -d /www/luci-static/resources

COPY stand/entrypoint-ui.sh /entrypoint-ui.sh
RUN chmod +x /entrypoint-ui.sh
ENTRYPOINT ["/entrypoint-ui.sh"]
CMD ["sleep", "infinity"]
